{
  "expo": {
    "name": "Claude Remote",
    "slug": "claude-remote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "claude-remote",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cc.anyyu.clauderemote.rn",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "连接局域网内 Mac 上的 Claude Code daemon",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cc.anyyu.clauderemote",
      "adaptiveIcon": {
        "backgroundColor": "#262624",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-lockup.png",
          "imageWidth": 254,
          "backgroundColor": "#FAF9F6",
          "dark": {
            "image": "./assets/splash-lockup-dark.png",
            "backgroundColor": "#141414"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "扫描 Mac 上的配对二维码，以及拍照发给 Claude",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择照片发给 Claude",
          "cameraPermission": "扫描 Mac 上的配对二维码，以及拍照发给 Claude",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "选择照片发给 Claude",
          "savePhotosPermission": "保存图片到相册",
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "./plugins/withIosLicenseNotices"
    ],
    "extra": {
      "eas": {
        "projectId": "ac02ab52-9f0c-4d11-804f-721c34ead519"
      }
    },
    "owner": "maxidanielnes-team"
  }
}
